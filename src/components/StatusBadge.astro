---
interface Props {
  status: 'in-progress' | 'done' | 'paused';
}
const { status } = Astro.props;
const styles = {
  'in-progress': { label: 'In progress', cls: 'bg-amber-500/15 text-amber-700 dark:text-amber-300' },
  done: { label: 'Done', cls: 'bg-emerald-500/15 text-emerald-700 dark:text-emerald-300' },
  paused: { label: 'Paused', cls: 'bg-zinc-500/15 text-zinc-600 dark:text-zinc-300' },
}[status];
---

<span class:list={['inline-flex shrink-0 items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium', styles.cls]}>
  <span class="size-1.5 rounded-full bg-current" aria-hidden="true"></span>
  {styles.label}
</span>
