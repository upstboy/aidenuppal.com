---
import { slugifyTag } from '../lib/content';
interface Props {
  tag: string;
  count?: number;
  size?: 'sm' | 'md';
}
const { tag, count, size = 'sm' } = Astro.props;
---

<a
  href={`/tags/${slugifyTag(tag)}/`}
  class:list={[
    'inline-flex items-center gap-1 rounded-full border border-accent/30 bg-accent/10 font-medium text-zinc-700 transition-colors hover:border-accent hover:bg-accent/20 dark:text-accent-soft',
    size === 'sm' ? 'px-2 py-0.5 text-xs' : 'px-3 py-1 text-sm',
  ]}
>
  #{tag}
  {count !== undefined && <span class="text-zinc-500 dark:text-accent-soft/60">{count}</span>}
</a>
