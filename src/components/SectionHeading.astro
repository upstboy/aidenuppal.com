---
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}
const { title, href, linkLabel = 'View all' } = Astro.props;
---

<div class="mb-6 flex items-baseline justify-between gap-4">
  <h2 class="text-2xl font-bold tracking-tight">{title}</h2>
  {
    href && (
      <a href={href} class="text-sm font-medium text-zinc-600 hover:text-accent-strong dark:text-zinc-400 dark:hover:text-accent">
        {linkLabel} →
      </a>
    )
  }
</div>
