---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import StatusBadge from './StatusBadge.astro';
import Tag from './Tag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, summary, cover, coverAlt, coverPosition, tags, status } = project.data;
---

<article
  class="light group relative flex flex-col overflow-hidden rounded-2xl border-2 border-card-edge bg-card text-zinc-900 transition-[box-shadow,border-color] hover:border-card-edge-strong hover:shadow-lg hover:shadow-card-edge/30"
>
  <div class="aspect-[16/10] overflow-hidden bg-card-well">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          style={coverPosition ? `object-position: ${coverPosition}` : undefined}
          loading="lazy"
        />
      ) : (
        <div class="grid h-full w-full place-items-center bg-gradient-to-br from-accent/30 via-accent/10 to-transparent text-zinc-400">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-10">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 15 5-5 4 4 3-3 6 6" />
          </svg>
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-lg font-semibold leading-snug tracking-tight">
        <a href={`/projects/${project.id}/`} class="after:absolute after:inset-0">{title}</a>
      </h3>
      <StatusBadge status={status} />
    </div>
    <p class="text-sm leading-relaxed text-zinc-700">{summary}</p>
    {
      tags.length > 0 && (
        <ul class="relative z-10 mt-auto flex flex-wrap gap-1.5 pt-1">
          {tags.map((t) => (
            <li>
              <Tag tag={t} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
