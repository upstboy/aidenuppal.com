---
import Search from 'astro-pagefind/components/Search.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Search" description="Search projects and posts.">
  <header class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Search</h1>
    <p class="mt-3 text-zinc-600 dark:text-zinc-400">Searches the full text of every project and post.</p>
  </header>

  <div class="mx-auto max-w-3xl">
    <Search
      id="search"
      className="pagefind-ui"
      uiOptions={{ showImages: false, showSubResults: true, excerptLength: 25, autofocus: true }}
    />
    <p class="mt-6 text-sm text-zinc-500 dark:text-zinc-400">
      The index is generated at build time, so search results appear only on the deployed site or after running <code>npm run build</code> locally.
    </p>
  </div>
</Base>
