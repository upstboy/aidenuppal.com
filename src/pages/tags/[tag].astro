---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PostItem from '../../components/PostItem.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getTagMap } from '../../lib/content';

export async function getStaticPaths() {
  const map = await getTagMap();
  return [...map.entries()].map(([slug, data]) => ({ params: { tag: slug }, props: data }));
}

const { tag, projects, posts } = Astro.props;
const total = projects.length + posts.length;
---

<Base title={`#${tag}`} description={`${total} ${total === 1 ? 'item' : 'items'} tagged ${tag}.`}>
  <header class="mb-10">
    <a href="/tags/" class="text-sm text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">← All tags</a>
    <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">#{tag}</h1>
    <p class="mt-3 text-zinc-600 dark:text-zinc-400">
      {projects.length} {projects.length === 1 ? 'project' : 'projects'} · {posts.length} {posts.length === 1 ? 'post' : 'posts'}
    </p>
  </header>

  {
    projects.length > 0 && (
      <section class="mb-14">
        <SectionHeading title="Projects" />
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </section>
    )
  }

  {
    posts.length > 0 && (
      <section>
        <SectionHeading title="Posts" />
        <div class="divide-y divide-zinc-200 border-t border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800">
          {posts.map((p) => (
            <PostItem post={p} />
          ))}
        </div>
      </section>
    )
  }
</Base>
