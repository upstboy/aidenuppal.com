---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tag from '../../components/Tag.astro';
import { getPosts, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, summary, date, updated, tags, cover, coverAlt } = post.data;
const project = post.data.project ? await getEntry(post.data.project) : undefined;
---

<Base title={title} description={summary} image={cover?.src} type="article">
  <article class="mx-auto max-w-3xl" data-pagefind-body data-pagefind-filter="Type:Post">
    <a href="/blog/" class="text-sm text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">← All posts</a>

    <header class="mt-4">
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        <time datetime={date.toISOString()}>{formatDate(date, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        {updated && <> · Updated {formatDate(updated)}</>}
      </p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">{summary}</p>

      {
        project && (
          <a
            href={`/projects/${project.id}/`}
            class="mt-5 inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 px-3 py-1.5 text-sm transition-colors hover:border-accent hover:bg-accent/10 dark:border-zinc-800 dark:bg-zinc-900"
          >
            <span class="text-zinc-500 dark:text-zinc-400">Part of</span>
            <span class="font-medium">{project.data.title}</span>
          </a>
        )
      }

      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2">
            {tags.map((t) => (
              <li>
                <Tag tag={t} size="md" />
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <Image
          src={cover}
          alt={coverAlt ?? title}
          class="mt-8 aspect-[16/9] w-full rounded-2xl border border-zinc-200 object-cover dark:border-zinc-800"
          loading="eager"
        />
      )
    }

    <div class="prose prose-zinc mt-10 max-w-none dark:prose-invert prose-headings:tracking-tight prose-a:text-accent-strong dark:prose-a:text-accent prose-img:rounded-xl">
      <Content />
    </div>
  </article>

  <nav class="mx-auto mt-16 grid max-w-3xl gap-4 border-t border-zinc-200 pt-8 sm:grid-cols-2 dark:border-zinc-800" aria-label="Post navigation">
    {
      older ? (
        <a href={`/blog/${older.id}/`} class="group rounded-xl border border-zinc-200 p-4 transition-colors hover:border-accent dark:border-zinc-800">
          <span class="text-xs uppercase tracking-wider text-zinc-500">← Older</span>
          <span class="mt-1 block font-medium group-hover:text-accent-strong dark:group-hover:text-accent">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer && (
        <a href={`/blog/${newer.id}/`} class="group rounded-xl border border-zinc-200 p-4 text-right transition-colors hover:border-accent dark:border-zinc-800">
          <span class="text-xs uppercase tracking-wider text-zinc-500">Newer →</span>
          <span class="mt-1 block font-medium group-hover:text-accent-strong dark:group-hover:text-accent">{newer.data.title}</span>
        </a>
      )
    }
  </nav>
</Base>
