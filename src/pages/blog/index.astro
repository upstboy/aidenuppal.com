---
import Base from '../../layouts/Base.astro';
import PostItem from '../../components/PostItem.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getUTCFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="Blog" description="Build logs, notes and whatever else is worth writing down.">
  <header class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Blog</h1>
    <!-- TODO: one line about what you write here -->
    <p class="mt-3 max-w-2xl text-zinc-600 dark:text-zinc-400">
      Build logs, debugging notes, and the occasional opinion. Mostly written so future me can find it again.
    </p>
  </header>

  {
    years.map((year) => (
      <section class="mb-10">
        <h2 class="mb-2 text-sm font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">{year}</h2>
        <div class="divide-y divide-zinc-200 border-t border-zinc-200 dark:divide-zinc-800 dark:border-zinc-800">
          {byYear.get(year)!.map((p) => (
            <PostItem post={p} showYear={false} />
          ))}
        </div>
      </section>
    ))
  }

  {posts.length === 0 && <p class="text-zinc-500">Nothing here yet.</p>}
</Base>
