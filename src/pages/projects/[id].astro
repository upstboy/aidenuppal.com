---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Tag from '../../components/Tag.astro';
import PostItem from '../../components/PostItem.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getProjects, getPosts, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, date, updated, status, tags, cover, coverAlt, coverPosition, repo, demo } = project.data;
const relatedPosts = (await getPosts()).filter((p) => p.data.project?.id === project.id);
---

<Base title={title} description={summary} image={cover?.src} type="article">
  <article class="mx-auto max-w-3xl" data-pagefind-body data-pagefind-filter="Type:Project">
    <a href="/projects/" class="text-sm text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">← All projects</a>

    <header class="mt-4">
      <div class="flex flex-wrap items-center gap-3">
        <StatusBadge status={status} />
        <span class="text-sm text-zinc-500 dark:text-zinc-400">
          Started {formatDate(date, { year: 'numeric', month: 'long' })}
          {updated && <> · Updated {formatDate(updated)}</>}
        </span>
      </div>
      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-lg text-zinc-600 dark:text-zinc-400">{summary}</p>

      {
        (repo || demo) && (
          <div class="mt-5 flex flex-wrap gap-3">
            {repo && (
              <a
                href={repo}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-lg bg-zinc-900 px-3.5 py-2 text-sm font-medium text-white transition-colors hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
                  <path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.7.3 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5Z" />
                </svg>
                Source code
              </a>
            )}
            {demo && (
              <a
                href={demo}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 px-3.5 py-2 text-sm font-medium transition-colors hover:border-zinc-400 hover:bg-zinc-50 dark:border-zinc-700 dark:hover:border-zinc-500 dark:hover:bg-zinc-900"
              >
                Live demo ↗
              </a>
            )}
          </div>
        )
      }

      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2">
            {tags.map((t) => (
              <li>
                <Tag tag={t} size="md" />
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <Image
          src={cover}
          alt={coverAlt ?? title}
          class="mt-8 aspect-[16/9] w-full rounded-2xl border border-zinc-200 object-cover dark:border-zinc-800"
          style={coverPosition ? `object-position: ${coverPosition}` : undefined}
          loading="eager"
        />
      )
    }

    <div class="prose prose-zinc mt-10 max-w-none dark:prose-invert prose-headings:tracking-tight prose-a:text-accent-strong dark:prose-a:text-accent prose-img:rounded-xl">
      <Content />
    </div>
  </article>

  {
    relatedPosts.length > 0 && (
      <section class="mx-auto mt-16 max-w-3xl border-t border-zinc-200 pt-10 dark:border-zinc-800">
        <SectionHeading title="Posts about this project" />
        <div class="divide-y divide-zinc-200 dark:divide-zinc-800">
          {relatedPosts.map((p) => (
            <PostItem post={p} />
          ))}
        </div>
      </section>
    )
  }
</Base>
