---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<Base title="Projects" description="Things I have built, am building, or have shelved for now.">
  <header class="mb-10">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Projects</h1>
    <!-- TODO: one line describing what kind of projects live here -->
    <p class="mt-3 max-w-2xl text-zinc-600 dark:text-zinc-400">
      Hardware, robots, firmware and the occasional piece of software. Each one has a writeup and, where it exists, a link to the code.
    </p>
  </header>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((p) => <ProjectCard project={p} />)}
  </div>
</Base>
