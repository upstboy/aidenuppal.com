---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="py-20 text-center">
    <p class="font-mono text-sm text-zinc-500">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">That page does not exist.</h1>
    <p class="mt-4 text-zinc-600 dark:text-zinc-400">It may have moved, or the link was wrong.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-zinc-950 hover:bg-accent-soft">Home</a>
      <a href="/search/" class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-medium dark:border-zinc-700">Search</a>
    </div>
  </section>
</Base>
