---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostItem from '../components/PostItem.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE } from '../config';
import { getProjects, getPosts } from '../lib/content';

const projects = (await getProjects()).slice(0, SITE.home.featuredProjects);
const posts = (await getPosts()).slice(0, SITE.home.recentPosts);
---

<Base>
  <section class="py-8 sm:py-14">
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">
      {SITE.hero.heading}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
      {SITE.hero.text}
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href="/projects/"
        class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-zinc-950 transition-colors hover:bg-accent-soft"
      >
        See the projects
      </a>
      <a
        href="/blog/"
        class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-medium transition-colors hover:border-zinc-400 hover:bg-zinc-50 dark:border-zinc-700 dark:hover:border-zinc-500 dark:hover:bg-zinc-900"
      >
        Read the blog
      </a>
      <a href="/about/" class="px-2 py-2 text-sm font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">
        More about me →
      </a>
    </div>
  </section>

  <section class="py-10">
    <SectionHeading title="Projects" href="/projects/" />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="py-10">
    <SectionHeading title="Recent posts" href="/blog/" />
    <div class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {posts.map((p) => <PostItem post={p} />)}
    </div>
  </section>
</Base>
