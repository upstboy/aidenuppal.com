---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostItem from '../components/PostItem.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { SITE } from '../config';
import { getProjects, getPosts } from '../lib/content';

const projects = await getProjects();
const posts = (await getPosts()).slice(0, SITE.home.recentPosts);
---

<Base>
  <section class="py-8 sm:py-14">
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">
      {SITE.hero.heading}
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
      {SITE.hero.text}
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a
        href="/projects/"
        class="rounded-lg bg-accent px-4 py-2 text-sm font-medium text-zinc-950 transition-colors hover:bg-accent-soft"
      >
        See the projects
      </a>
      <a
        href="/blog/"
        class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-medium transition-colors hover:border-zinc-400 hover:bg-zinc-50 dark:border-zinc-700 dark:hover:border-zinc-500 dark:hover:bg-zinc-900"
      >
        Read the blog
      </a>
      <a href="/about/" class="px-2 py-2 text-sm font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white">
        More about me →
      </a>
    </div>
  </section>

  <section class="py-10">
    <SectionHeading title="Projects" href="/projects/">
      <div slot="actions" id="project-arrows" class="hidden items-center gap-1" data-carousel-arrows>
        <button
          type="button"
          data-dir="-1"
          aria-label="Previous projects"
          class="grid size-8 place-items-center rounded-full border border-zinc-300 text-zinc-600 transition-colors hover:border-accent hover:text-accent-strong disabled:cursor-default disabled:opacity-30 disabled:hover:border-zinc-300 disabled:hover:text-zinc-600 dark:border-zinc-700 dark:text-zinc-400 dark:hover:text-accent dark:disabled:hover:border-zinc-700 dark:disabled:hover:text-zinc-400"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="m15 18-6-6 6-6" /></svg>
        </button>
        <button
          type="button"
          data-dir="1"
          aria-label="Next projects"
          class="grid size-8 place-items-center rounded-full border border-zinc-300 text-zinc-600 transition-colors hover:border-accent hover:text-accent-strong disabled:cursor-default disabled:opacity-30 disabled:hover:border-zinc-300 disabled:hover:text-zinc-600 dark:border-zinc-700 dark:text-zinc-400 dark:hover:text-accent dark:disabled:hover:border-zinc-700 dark:disabled:hover:text-zinc-400"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4"><path d="m9 18 6-6-6-6" /></svg>
        </button>
      </div>
    </SectionHeading>

    <!-- Horizontal, snap-scrolling track. Swipes on touch, arrows on desktop. 1 / 2 / 3 cards per view. -->
    <div
      id="project-track"
      class="-mx-4 flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth px-4 pb-2 [scrollbar-width:none] sm:mx-0 sm:px-0 [&::-webkit-scrollbar]:hidden"
      tabindex="0"
      aria-label="Projects carousel"
    >
      {
        projects.map((p) => (
          <div class="w-full shrink-0 snap-start sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]">
            <ProjectCard project={p} />
          </div>
        ))
      }
    </div>
  </section>

  <script>
    const track = document.getElementById('project-track');
    const arrows = document.getElementById('project-arrows');
    if (track && arrows) {
      const [prev, next] = arrows.querySelectorAll<HTMLButtonElement>('button');
      const step = () => {
        const first = track.firstElementChild as HTMLElement | null;
        const gap = parseFloat(getComputedStyle(track).columnGap || '0') || 0;
        return first ? first.offsetWidth + gap : track.clientWidth;
      };
      const update = () => {
        const overflow = track.scrollWidth > track.clientWidth + 1;
        arrows.classList.toggle('hidden', !overflow);
        arrows.classList.toggle('flex', overflow);
        prev.disabled = track.scrollLeft <= 1;
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
      };
      for (const b of [prev, next]) {
        b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: 'smooth' }));
      }
      track.addEventListener('scroll', update, { passive: true });
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') next.click();
        if (e.key === 'ArrowLeft') prev.click();
      });
      window.addEventListener('resize', update);
      update();
    }
  </script>

  <section class="py-10">
    <SectionHeading title="Recent posts" href="/blog/" />
    <div class="divide-y divide-zinc-200 dark:divide-zinc-800">
      {posts.map((p) => <PostItem post={p} />)}
    </div>
  </section>
</Base>
